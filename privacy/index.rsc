17:["$","ul","41",{"children":[["$","li","41",{"children":"Получить информацию о своих персональных данных, обрабатываемых Оператором;"}],["$","li","42",{"children":"Требовать уточнения, блокирования или уничтожения данных, если они неполные, устаревшие, неточные;"}],["$","li","43",{"children":"Отозвать согласие на обработку персональных данных;"}],["$","li","44",{"children":"Обратиться в Роскомнадзор или суд для защиты своих прав."}]]}]
