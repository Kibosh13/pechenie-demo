13:["$","ul","36",{"children":[["$","li","36",{"children":"Службы доставки (Яндекс Доставка, Достависта, доставка собственными силами продавца) — только ФИО, адрес, телефон;"}],["$","li","37",{"children":"Платёжные системы (при подключении онлайн-оплаты) — только данные, необходимые для проведения платежа."}]]}]
14:["$","p","38",{"children":"7.2. Трансграничная передача персональных данных не осуществляется."}]
