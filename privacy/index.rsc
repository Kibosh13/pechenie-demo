3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Политика обработки персональных данных — Печенье в стакане"}],["$","meta","1",{"name":"description","content":"Печенье в стакане: сливочное, сливочное матча и пармезан с розмарином. Ручная работа с кухни Дуэ Пасси. 150 г — 450 ₽."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow, noarchive"}],["$","meta","3",{"name":"googlebot","content":"noindex, nofollow, noimageindex"}],["$","link","4",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/pechenie-demo/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","5",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/pechenie-demo/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["privacy"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"privacy","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-er